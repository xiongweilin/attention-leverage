# Local llm-gateway Agent entry (port comes from llm-gateway/config/gateway.json).
# The gateway replaces this client marker with its configured ChatGPT subscription credential.
OPENAI_API_KEY=local-gateway
OPENAI_BASE_URL=http://127.0.0.1:4101/v1
OPENAI_MODEL=gpt-6-luna
LLM_TIMEOUT_SECONDS=90

# Optional provider credentials / identity.
GITHUB_TOKEN=
NVD_API_KEY=
# SEC asks automated clients to identify themselves. Example format:
# SEC_USER_AGENT=Your Name your-email@example.com
SEC_USER_AGENT=
# ReliefWeb requires an approved appname for API access.
RELIEFWEB_APPNAME=

DATABASE_PATH=data/attention.db
MAX_RAW_ITEMS=320
MAX_FILTERED_ITEMS=72
MAX_OUTPUT_ITEMS=24
REQUEST_TIMEOUT_SECONDS=20
SOURCE_CONCURRENCY=12
