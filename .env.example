# Optional. Without an LLM the system still runs with a deterministic fallback planner/ranker.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# Optional, improves GitHub API rate limits.
GITHUB_TOKEN=

# Runtime tuning
MAX_RAW_ITEMS=180
MAX_FILTERED_ITEMS=60
MAX_OUTPUT_ITEMS=20
REQUEST_TIMEOUT_SECONDS=20
